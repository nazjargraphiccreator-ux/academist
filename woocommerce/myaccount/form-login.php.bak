    transform: translateX(20px);
}
body.rima-lang-ro .rima-lang-label-en { opacity: 0.5; }
body.rima-lang-ro .rima-lang-label-ro { opacity: 1; color: var(--rima-navy) !important; }
body:not(.rima-lang-ro) .rima-lang-label-en { opacity: 1; color: var(--rima-navy) !important; }
body:not(.rima-lang-ro) .rima-lang-label-ro { opacity: 0.5; }
</style>

<script>
jQuery(document).ready(function($) {
    // Read hash on load to switch to register tab automatically
    if(window.location.hash === '#rima-register-tab') {
        setTimeout(function() {
            $('#register-tab-btn').trigger('click');
        }, 50);
    }

    // 1. Manual Tab Switching (Fallback if Bootstrap JS is missing)
    $('[data-bs-toggle="pill"]').on('click', function(e) {
        e.preventDefault();
        
        // Remove active class from all tabs
        $('[data-bs-toggle="pill"]').removeClass('active');
        
        // Add active class to clicked tab
        $(this).addClass('active');
        
        // Hide all tab panes
        $('.tab-pane').removeClass('show active');
        
        // Show target pane
        var target = $(this).attr('data-bs-target');
        $(target).addClass('show active');
    });

    // 2. Custom Password Toggle
    $('.rima-eye-btn').on('click', function(e) {
        e.preventDefault();
        var input = $(this).siblings('input');
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
            $(this).css('opacity', '0.5'); // visual feedback
        } else {
            input.attr('type', 'password');
            $(this).css('opacity', '1');
        }
    });

    // Custom Password Strength Meter
    $('#reg_password').on('input', function() {
        var val = $(this).val();
        var container = $('.rima-password-strength-container');
        var segments = $('.strength-segment');
        var textEl = $('#rima-strength-text');
        var isRo = document.body.classList.contains('rima-lang-ro');
        
        if (val.length === 0) {
            container.slideUp(200);
            return;
        }
        
        container.slideDown(200);
        
        var score = 0;
        if (val.length > 5) score += 1;
        if (val.length > 8) score += 1;
        if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score += 1;
        if (/[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) score += 1;
        
        segments.removeClass('bg-danger bg-warning bg-success opacity-25').addClass('bg-secondary opacity-25');
        
        if (score === 1 || score === 2) {
            $('#strength-1').removeClass('bg-secondary opacity-25').addClass('bg-danger');
            if (score === 2) $('#strength-2').removeClass('bg-secondary opacity-25').addClass('bg-danger');
            textEl.text(isRo ? 'Slabă' : 'Weak').removeClass('text-warning text-success').addClass('text-danger');
        } else if (score === 3) {
            $('#strength-1, #strength-2, #strength-3').removeClass('bg-secondary opacity-25').addClass('bg-warning');
            textEl.text(isRo ? 'Medie' : 'Medium').removeClass('text-danger text-success').addClass('text-warning');
        } else if (score === 4) {
            segments.removeClass('bg-secondary opacity-25').addClass('bg-success');
            textEl.text(isRo ? 'Puternică' : 'Strong').removeClass('text-danger text-warning').addClass('text-success');
        }
    });
    
    // Login specific language toggle logic (since this is outside the dashboard sidebar)
    $('#rima-lang-switch-login').on('click', function() {
        var isRo = document.body.classList.contains('rima-lang-ro');
        var newLang = isRo ? 'en' : 'ro';
        
        if (newLang === 'ro') {
            document.body.classList.add('rima-lang-ro');
        } else {
            document.body.classList.remove('rima-lang-ro');
        }
        localStorage.setItem('rima_lang', newLang);

        var domain = window.location.hostname;
        document.cookie = "googtrans=/en/" + newLang + "; path=/; domain=" + domain;
        document.cookie = "googtrans=/en/" + newLang + "; path=/";

        var select = document.querySelector('select.goog-te-combo');
        if (select) {
            select.value = newLang;
            select.dispatchEvent(new Event('change'));
        }

        // Save to server
        $.post(rima_ajax_obj.ajax_url, {
            action: 'rima_save_lang_pref',
            lang:   newLang,
            nonce:  rima_ajax_obj.nonce
        }).always(function() {
            window.location.reload();
        });
    });
});
</script>

<?php do_action( 'woocommerce_after_customer_login_form' ); ?>
